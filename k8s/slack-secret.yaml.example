# TEMPLATE ONLY - never commit a real webhook URL.
#
# Easiest: let the Makefile create the Secret from an env var (nothing on disk):
#   export SLACK_WEBHOOK_URL='https://hooks.slack.com/services/...'
#   make slack-secret
#
# Or copy this file to slack-secret.yaml (git-ignored), edit, and apply it.
apiVersion: v1
kind: Secret
metadata:
  name: slack-webhook
  namespace: log-doctor
type: Opaque
stringData:
  webhook-url: "https://hooks.slack.com/services/REPLACE/ME/PLEASE"
